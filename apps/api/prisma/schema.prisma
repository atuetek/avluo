// Avluo – Phase 1 (Szenario A)
// Multi-Tenant-fähiges Datenbank-Schema mit PostgreSQL Row-Level-Security
// Stack: Prisma + PostgreSQL 16
// Wiederverwendungsbasis: organize4u + sm-display (gleicher Prisma-Stil)

generator client {
  provider        = "prisma-client-js"
  // RLS-konform: Jede Query muss explizit tenant_id setzen
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ============================================================================
// TENANT
// ============================================================================

/// Eine Kooperatif-Siedlung = 1 Tenant
/// Isolation: jede Tabelle referenziert tenant_id, RLS-Policies filtern
model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique // "akici-mah" → akici-mah.avluo.app
  name        String       @db.VarChar(200) // "Akıcı Mahalle Kooperatifi"
  subdomain   String       @unique @db.VarChar(100)
  defaultLang String       @default("tr-TR") @db.VarChar(5) // tr-TR, en-US, de-DE
  plan        TenantPlan   @default(FREE)
  status      TenantStatus @default(ACTIVE)
  memberCount Int          @default(0) // cached, max 2000
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  members         Member[]
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  conversations   Conversation[]
  messages        Message[]
  events          Event[]
  eventRsvps      EventRsvp[]
  polls           Poll[]
  pollVotes       PollVote[]
  emergencyAlerts EmergencyAlert[]
  media           Media[]
  invites         Invite[]
  auditLogs       AuditLog[]

  @@map("tenants")
}

enum TenantPlan {
  FREE // bis 100 Member
  STANDARD // bis 1000
  PREMIUM // bis 2000+
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ============================================================================
// MEMBER (Eigentümer einer Siedlung)
// ============================================================================

/// Ein Eigentümer. WICHTIG: jede Member-Zeile ist genau 1 Tenant zugeordnet.
/// Wenn Person in 2 Siedlungen ist → 2 Member-Zeilen (verschiedene tenant_id).
model Member {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid // referenziert User

  // Siedlungs-spezifische Daten
  houseNumber String?    @db.VarChar(50) // "A-12"
  blockName   String?    @db.VarChar(50) // "Block A"
  role        MemberRole @default(MEMBER)

  // Profil
  displayName   String  @db.VarChar(100)
  avatarUrl     String? @db.Text
  preferredLang String  @default("tr-TR") @db.VarChar(5)
  phone         String? @db.VarChar(20)
  isVerified    Boolean @default(false) // hat Adresse nachgewiesen

  joinedAt     DateTime  @default(now())
  lastActiveAt DateTime?
  isActive     Boolean   @default(true)

  // Relations
  tenant                   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts                    Post[]
  comments                 Comment[]
  likes                    Like[]
  messagesSent             Message[]            @relation("MessageSender")
  conversations            MemberConversation[]
  eventRsvps               EventRsvp[]
  pollVotes                PollVote[]
  emergencyAlertsTriggered EmergencyAlert[]
  Poll                     Poll[]

  // Eindeutigkeit: 1 User pro Tenant nur 1x
  @@unique([tenantId, userId])
  @@index([tenantId, houseNumber])
  @@index([tenantId, role])
  @@map("members")
}

enum MemberRole {
  MEMBER // normaler Eigentümer
  ADMIN // Yönetim-Mitglied
  SUPER_ADMIN // Kooperatif-Başkan
  GUARD // Site-Güvenlik (Phase 2)
}

// ============================================================================
// USER (global, plattform-weit)
// ============================================================================

/// Globale User-Identität. Wird zu 1..n Tenants via Member-Join-Tabelle.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String?   @unique @db.Citext // case-insensitive
  phone         String?   @unique @db.VarChar(20) // E.164
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  passwordHash  String?   @db.Text // null wenn nur OAuth
  locale        String    @default("tr-TR") @db.VarChar(5)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  // Relations
  members       Member[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.Text
  expiresAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  provider       String   @db.VarChar(50) // "google", "apple"
  providerUserId String   @db.Text
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

// ============================================================================
// POST (Timeline)
// ============================================================================

/// Hauptinhalt der Timeline. Polling-optimiert: createdAt ist indiziert.
model Post {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  authorId String @db.Uuid

  content     String  @db.Text // max 5000 chars (App-Layer enforced)
  contentHtml String? @db.Text // gerendert (sanitized)
  lang        String  @default("tr-TR") @db.VarChar(5) // Sprache des Posts

  // Pinned/Announcement für Yönetim
  isPinned       Boolean   @default(false)
  pinnedAt       DateTime?
  isAnnouncement Boolean   @default(false) // wichtige Info, andere Optik

  // Engagement (cached counters für schnelle Timeline)
  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  // Moderation
  isHidden     Boolean @default(false)
  hiddenReason String? @db.VarChar(200)
  hiddenBy     String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  // Relations
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author   Member      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  media    PostMedia[]

  // Performance: composite index für Timeline-Query
  @@index([tenantId, isPinned, createdAt(sort: Desc)])
  @@index([tenantId, isHidden, createdAt(sort: Desc)])
  @@index([tenantId, authorId, createdAt(sort: Desc)])
  @@map("posts")
}

/// M:n Post ↔ Media (Bilder, Videos)
model PostMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @db.Uuid
  mediaId   String   @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now())

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@map("post_media")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  parentId  String?  @db.Uuid // nested comments
  content   String   @db.Text
  lang      String   @default("tr-TR") @db.VarChar(5)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  Member    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([tenantId, postId, createdAt])
  @@index([tenantId, parentId])
  @@map("comments")
}

model Like {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, postId, authorId])
  @@index([tenantId, postId])
  @@map("likes")
}

// ============================================================================
// DIRECT MESSAGES (1:1 + Gruppen)
// ============================================================================

/// 1:1 oder Gruppe. Tenant-isoliert: alle Members müssen im selben Tenant sein.
model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @db.Uuid
  type          ConversationType @default(DIRECT)
  title         String?          @db.VarChar(200) // nur bei GROUP
  createdAt     DateTime         @default(now())
  lastMessageAt DateTime?

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members  MemberConversation[]
  messages Message[]

  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

enum ConversationType {
  DIRECT // 1:1
  GROUP // n:n
  BROADCAST // nur Admins posten
}

model MemberConversation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @db.Uuid
  memberId       String    @db.Uuid
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId])
  @@map("member_conversations")
}

model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String    @db.Text
  lang           String    @default("tr-TR") @db.VarChar(5)
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  isDeleted      Boolean   @default(false)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Member       @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

// ============================================================================
// EVENTS (Veranstaltungen)
// ============================================================================

model Event {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @db.Uuid
  organizerId String @db.Uuid

  title        String    @db.VarChar(200)
  description  String    @db.Text
  lang         String    @default("tr-TR") @db.VarChar(5)
  location     String?   @db.VarChar(200) // "Siedlungs-Innenhof"
  startsAt     DateTime
  endsAt       DateTime?
  rsvpCount    Int       @default(0) // cached
  maxAttendees Int?
  isCancelled  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rsvps  EventRsvp[]

  @@index([tenantId, startsAt])
  @@map("events")
}

model EventRsvp {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @db.Uuid
  eventId   String     @db.Uuid
  memberId  String     @db.Uuid
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId, memberId])
  @@index([tenantId, eventId])
  @@map("event_rsvps")
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

// ============================================================================
// POLLS (Umfragen / Abstimmungen)
// ============================================================================

model Poll {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  authorId      String    @db.Uuid
  question      String    @db.Text
  description   String?   @db.Text
  lang          String    @default("tr-TR") @db.VarChar(5)
  isAnonymous   Boolean   @default(false)
  allowMultiple Boolean   @default(false)
  closesAt      DateTime?
  isClosed      Boolean   @default(false)
  voteCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author  Member       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("polls")
}

model PollOption {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId    String @db.Uuid
  label     String @db.VarChar(500)
  position  Int    @default(0)
  voteCount Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, position])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  pollId    String   @db.Uuid
  optionId  String   @db.Uuid
  voterId   String   @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voter  Member     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pollId, voterId, optionId])
  @@index([tenantId, pollId])
  @@map("poll_votes")
}

// ============================================================================
// EMERGENCY (Notfall-Alerts)
// ============================================================================

/// Separate Tabelle wegen SLA-Anforderung. Broadcast an alle Tenant-Members.
model EmergencyAlert {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @db.Uuid
  triggeredBy       String            @db.Uuid // Member-Id
  type              EmergencyType
  severity          EmergencySeverity @default(HIGH)
  title             String            @db.VarChar(200)
  message           String            @db.Text
  location          String?           @db.VarChar(200)
  // Wie wurde kommuniziert:
  pushSent          Boolean           @default(false)
  smsSent           Boolean           @default(false)
  emailSent         Boolean           @default(false)
  recipients        Int               @default(0) // cached
  acknowledgedCount Int               @default(0)
  createdAt         DateTime          @default(now())
  resolvedAt        DateTime?

  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  triggeredByMember Member @relation(fields: [triggeredBy], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("emergency_alerts")
}

enum EmergencyType {
  EARTHQUAKE // Erdbeben
  FIRE // Feuer
  MEDICAL // Medizinischer Notfall
  SECURITY // Sicherheitsvorfall
  INTRUDER // Eindringling
  OTHER
}

enum EmergencySeverity {
  CRITICAL
  HIGH
  MEDIUM
}

// ============================================================================
// MEDIA
// ============================================================================

model Media {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  url       String   @db.Text
  thumbUrl  String?  @db.Text
  mimeType  String   @db.VarChar(100)
  sizeBytes Int
  width     Int?
  height    Int?
  duration  Int? // for video, seconds
  isScanned Boolean  @default(false) // virus scanned
  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts  PostMedia[]

  @@index([tenantId, createdAt])
  @@map("media")
}

// ============================================================================
// INVITES (Einladungen zur Siedlung)
// ============================================================================

model Invite {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  code        String    @unique @db.VarChar(50) // z.B. "AKICI-2026-A12"
  email       String?   @db.Citext
  phone       String?   @db.VarChar(20)
  houseNumber String?   @db.VarChar(50)
  usedAt      DateTime?
  usedBy      String?   @db.Uuid
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, code])
  @@map("invites")
}

// ============================================================================
// AUDIT LOG (DSGVO + Sicherheit)
// ============================================================================

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @db.Uuid // null für platform-weite Events
  userId    String?  @db.Uuid
  action    String   @db.VarChar(100) // "post.create", "member.ban", etc
  resource  String?  @db.VarChar(100) // "post:abc123"
  metadata  Json?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
